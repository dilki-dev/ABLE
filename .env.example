# Existing Neon PostgreSQL connection
DATABASE_URL=

# Admin authentication (generate with: npm run hash-admin-password)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# One-way hashing salt for enquiry/login rate limiting
ENQUIRY_HASH_SECRET=

# Cloudflare Turnstile (required in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Explicit local-only bypass; never set true in Production or Preview
TURNSTILE_DEV_BYPASS=false

# Added by the existing Vercel Blob connection
BLOB_READ_WRITE_TOKEN=

# Optional transactional email notifications through Resend
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
REPLY_TO_EMAIL=hello@ableconstructions.lk

# Optional Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
