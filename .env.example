# PostgreSQL connection string from Neon or Vercel Storage
DATABASE_URL=

# Use a strong unique admin password and a random 32+ character session secret
ADMIN_PASSWORD=
SESSION_SECRET=

# Salt used to anonymize enquiry IP addresses (may match SESSION_SECRET, but a separate value is preferable)
ENQUIRY_HASH_SECRET=

# Added automatically when a Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=

# Final production website URL
NEXT_PUBLIC_SITE_URL=https://ableksjnvks.vercel.app
